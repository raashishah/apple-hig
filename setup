#!/usr/bin/env bash
# Install /hig (+ /hig-upgrade) into Cursor's global skills folder (gstack-style).
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
DEST_DIR="${HOME}/.cursor/skills"

link_skill() {
  local name="$1"
  local src="$REPO_ROOT/skills/$name"
  local dest="$DEST_DIR/$name"
  if [[ ! -f "$src/SKILL.md" ]]; then
    echo "error: missing $src/SKILL.md" >&2
    exit 1
  fi
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "error: $dest exists and is not a symlink. Move it aside, then re-run ./setup" >&2
    exit 1
  fi
  ln -sfn "$src" "$dest"
  echo "Installed: $dest -> $src"
}

mkdir -p "$DEST_DIR"
chmod +x "$REPO_ROOT/setup" \
  "$REPO_ROOT/scripts/upgrade.sh" \
  "$REPO_ROOT/scripts/upgrade-check.sh" 2>/dev/null || true

# Drop legacy name from 0.3.1
rm -f "$DEST_DIR/hig-update"

link_skill hig
link_skill hig-upgrade

echo
echo "In Cursor, run:  /hig"
echo "Upgrade later:   /hig upgrade   (or say \"HIG upgrade\")"
echo "Also useful:     /hig review --viewport 768,375"
echo "                 /hig adapt <surface>"
