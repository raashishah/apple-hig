#!/usr/bin/env bash
# Link /hig and the eight topic skills into Cursor's global skills folder.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"
DEST_DIR="${HOME}/.cursor/skills"

link_skill() {
  local name="$1"
  local src="$REPO_ROOT/skills/$name"
  local dest="$DEST_DIR/$name"
  if [[ ! -f "$src/SKILL.md" ]]; then
    echo "error: missing $src/SKILL.md" >&2
    exit 1
  fi
  if [[ -e "$dest" && ! -L "$dest" ]]; then
    echo "error: $dest exists and is not a symlink. Move it aside, then re-run ./setup" >&2
    exit 1
  fi
  ln -sfn "$src" "$dest"
  echo "Installed: $dest -> $src"
}

mkdir -p "$DEST_DIR"
rm -f "$DEST_DIR/hig-update" "$DEST_DIR/hig-upgrade" "$DEST_DIR/hig-react"

link_skill hig
link_skill hig-typography
link_skill hig-color
link_skill hig-dark-mode
link_skill hig-tab-bars
link_skill hig-lists
link_skill hig-buttons
link_skill hig-text-fields
link_skill hig-motion

echo
echo "In Cursor, run:  /hig"
